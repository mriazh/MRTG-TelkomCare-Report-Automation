# Base URLs (Do not include trailing slashes)
BASE_URL_SID=https://example.telkomcare.com/mrtg/sid
BASE_URL_GRAPH=https://example.telkomcare.com/mrtg/graph

# Timeouts & Waits (Seconds)
WAIT_TIMEOUT=10
LONG_TIMEOUT=30
LOGIN_WAIT=60

# Retries
MAX_RETRIES=3
MAX_GRAPH_RETRIES=2

# Browser Configuration (Valid values: auto, chrome, chromium, firefox, edge)
# BROWSER_TYPE defaults to auto (auto-detects installed browser)
BROWSER_TYPE=auto

# Optional: path to browser binary e.g. /usr/bin/chromium-browser on Linux
BROWSER_BINARY_LOCATION=

# Auto-Login Credentials (optional; requires Gemini API key and TOTP secret)
# AUTO_LOGIN_ENABLED=false (set to true to enable automated login)
AUTO_LOGIN_ENABLED=false
# TELKOM_USER=your_username
# TELKOM_PASSWORD=your_password
# TOTP_SECRET=your_base32_secret_key

# Gemini CAPTCHA Solving (requires Gemini API key from Google AI Studio)
GEMINI_API_KEY=
# GEMINI_MODEL defaults to gemini-3.5-flash-lite if unset
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview

# OCR Configuration
OCR_CONFIDENCE_THRESHOLD=0.85
OCR_GEMINI_OBSERVE=false
